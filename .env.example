# MediaDillo — environment configuration
# Copy to .env and fill in your values.

# PostgreSQL password — change before first run
DB_PASSWORD=changeme

# TMDB API key (required) — https://www.themoviedb.org/settings/api
# Use the "API Key (v3 auth)" value, not the read access token.
TMDB_API_KEY=

# TVDB API key (optional) — fallback for TV episode numbering edge cases
TVDB_API_KEY=

# Scan roots — JSON array of {path, label, type}
# type is "movies" or "tv"
# Paths must match the container-side mount point in docker-compose.yml
SCAN_ROOTS='[
    {"path":"/mnt/nas/film",    "label":"Films",    "type":"movies"},
    {"path":"/mnt/nas/film_4k", "label":"4K Films", "type":"movies"},
    {"path":"/mnt/nas/tv",      "label":"TV Shows", "type":"tv"}
]'

# Jellyfin integration (optional) — app works fully without this
# Get API key from Jellyfin: Dashboard → Advanced → API Keys → +
JELLYFIN_URL=
JELLYFIN_API_KEY=

# Application port (default: 7731)
# PORT=7731
