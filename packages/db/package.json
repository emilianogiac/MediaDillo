    "db:push": "prisma db push",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "prisma": "^5.19.0",
    "typescript": "^5.5.4"
  }
